{
  "uid": "scholars-queues",
  "title": "Scholars AI - Queues",
  "schemaVersion": 40,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["scholars-ai"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Visible messages by queue",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "scholar_pgmq_visible_messages", "legendFormat": "{{queue}}" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Oldest visible age",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "scholar_pgmq_oldest_visible_age_seconds", "legendFormat": "{{queue}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue wait P95",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(scholar_agent_queue_wait_seconds_bucket[5m])))", "legendFormat": "{{queue}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Retry and dead-letter rate",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (queue) (rate(scholar_agent_jobs_retried_total[5m]))", "legendFormat": "retry {{queue}}" },
        { "refId": "B", "expr": "sum by (queue) (rate(scholar_agent_jobs_dead_lettered_total[5m]))", "legendFormat": "dead {{queue}}" }
      ]
    }
  ]
}
