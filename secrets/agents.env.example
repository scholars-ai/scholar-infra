# 复制为 agents.env（VPS 部署工作区内，绝不入库）
DATABASE_URL=postgres://scholar:replace-with-postgres-password@postgres:5432/scholar?sslmode=disable
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SF_API_KEY=
VTRIX_API_KEY=
VTRIX_MODEL=gpt-5.6-sol
SF_EMBED_MODEL=BAAI/bge-m3
EMBED_BACKEND=siliconflow
RSSHUB_BASE=http://host.docker.internal:1200
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
SERVICE_VERSION=dev
DEPLOYMENT_ENVIRONMENT=prod
JOB_TIMEOUT_SECONDS=240
PGMQ_VISIBILITY_TIMEOUT_SECONDS=300
